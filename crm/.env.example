# Mokshify Desk — environment. Copy to .env.local for development. Never commit real values.

# Database. Production: the Neon connection string (postgres://…?sslmode=require).
# Local development and tests: a PGlite data directory, e.g. pglite://./.data/dev
DATABASE_URL=pglite://./.data/dev

# The first owner account, created by `npm run seed` (no public sign-up).
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-to-a-long-passphrase

# Public site origins allowed to POST /api/public/leads (comma-separated).
PUBLIC_FORM_ORIGINS=https://mokshify.io,https://www.mokshify.io

# This app's own public URL (used in notification emails).
APP_URL=https://crm.mokshify.io

# New-lead notification email (optional: without SMTP_HOST the email is skipped).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Mokshify Desk <desk@mokshify.io>
NOTIFY_EMAIL=

# Demo data only (npm run seed:demo): password for the fictional staff user staff@example.com.
DEMO_STAFF_PASSWORD=
